generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
  theme    = "default"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  CLIENT
  ORGANIZATION
  ADMIN
}

enum ComplaintStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  passwordHash            String
  name                    String?
  role                    Role                 @default(CLIENT)
  isBlocked               Boolean              @default(false)
  blockExpiry             DateTime?
  emailVerified           Boolean              @default(false)
  verificationToken       String?
  pendingEmail            String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  clientProfile           ClientProfile?
  organizationProfile     OrganizationProfile?
  warnings                UserWarning[]
  courseComplaints        CourseComplaint[]
  organizationComplaints  OrganizationComplaint[]
}

model UserWarning {
  id     String   @id @default(uuid())
  userId String
  reason String   @db.Text
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CourseComplaint {
  id        String          @id @default(uuid())
  courseId  String
  userId    String
  reason    String          @db.Text
  status    ComplaintStatus @default(PENDING)
  createdAt DateTime        @default(now())
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
}

model CommentComplaint {
  id             String              @id @default(uuid())
  reviewId       String
  organizationId String
  reason         String              @db.Text
  status         ComplaintStatus     @default(PENDING)
  createdAt      DateTime            @default(now())
  review         Review              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization   OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([organizationId])
}

model OrganizationComplaint {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  reason         String              @db.Text
  status         ComplaintStatus     @default(PENDING)
  createdAt      DateTime            @default(now())
  organization   OrganizationProfile @relation("OrgProfileComplaints", fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model ClientProfile {
  id           String     @id @default(uuid())
  user_id      String     @unique
  full_name    String?    @db.Text
  description  String?    @db.Text
  age          Int?
  phone_number String?    @db.Text
  instagram    String?    @db.Text
  telegram     String?    @db.Text
  facebook     String?    @db.Text
  isMilitary              Boolean?   @default(false)
  isMilitaryVerified      Boolean    @default(false)
  militaryVerificationCode String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reviews      Review[]
  enrollments  Purchase[] @relation("StudentEnrollments")

  @@index([user_id])
}

model OrganizationProfile {
  id                String             @id @default(uuid())
  user_id           String             @unique
  full_name         String?            @db.Text
  description       String?            @db.Text
  phone_number      String?            @db.Text
  instagram         String?            @db.Text
  telegram          String?            @db.Text
  facebook          String?            @db.Text
  address           String?            @db.Text
  contact_email     String?            @db.Text
  edrpou            String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  courses               Course[]                @relation("OrganizationCourses")
  enrollments           Purchase[]              @relation("OrganizationEnrollments")
  commentComplaints     CommentComplaint[]
  organizationComplaints OrganizationComplaint[] @relation("OrgProfileComplaints")

  @@index([user_id])
}

model Review {
  id               String             @id @default(uuid())
  rating           Int
  comment          String?            @db.Text
  courseId         String
  profileId        String
  createdAt        DateTime           @default(now())
  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  profile          ClientProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  commentComplaints CommentComplaint[]

  @@unique([profileId, courseId])
  @@index([courseId])
  @@index([profileId])
}

model Course {
  id              String            @id @default(uuid())
  organizationId  String
  title           String            @db.Text
  startAge        Int?
  endAge          Int?
  description     String?           @db.Text
  imageUrl        String?           @db.Text
  isPublished     Boolean           @default(false)
  categoryId      String
  cityId          String?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime          @default(now())
  levelId         String?
  price           Float?            @default(0) @db.Float
  location        String?           @db.Text
  parentCourseId  String?
  purchases       Purchase[]
  reviews         Review[]
  runs            CourseRun[]
  complaints      CourseComplaint[]
  parentCourse    Course?           @relation("CourseHistory", fields: [parentCourseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  repeatedCourses Course[]          @relation("CourseHistory")
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  city            City?             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  level           Level?            @relation(fields: [levelId], references: [id], onDelete: Cascade)
  organization    OrganizationProfile @relation("OrganizationCourses", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([categoryId])
  @@index([cityId])
  @@index([levelId])
  @@index([parentCourseId])
}

model Purchase {
  id             String              @id @default(uuid())
  customerId     String
  courseId       String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organizationId String
  confirmed      Boolean             @default(false)
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        ClientProfile       @relation("StudentEnrollments", fields: [customerId], references: [id])
  organization   OrganizationProfile @relation("OrganizationEnrollments", fields: [organizationId], references: [id])

  @@unique([customerId, courseId])
  @@index([courseId])
  @@index([customerId])
  @@index([organizationId])
}

model CourseRun {
  id        String   @id @default(uuid())
  courseId  String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model City {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model Level {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}
